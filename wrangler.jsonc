// Cloudflare configuration: one Worker serves the interface (dist/, built by Vite) and the API;
// the club's data lives in a Durable Object with its own SQLite database (free plan compatible).
// A second Durable Object, the demo space, holds the fictitious data of the training mode.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "club-prive",
  "main": "worker/index.js",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/login-smoke.mp4"]
  },
  "durable_objects": {
    "bindings": [
      { "name": "CLUB", "class_name": "ClubDO" },
      { "name": "DEMO", "class_name": "DemoDO" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["ClubDO"] },
    { "tag": "v2", "new_sqlite_classes": ["DemoDO"] }
  ],
  // The daily automatic renewals (worker/index.js, scheduled): 05:00 UTC is 06:00 in Brazzaville.
  "triggers": { "crons": ["0 5 * * *"] },
  "observability": { "enabled": true }
  // Secret (not in this file): SETUP_TOKEN, the installation code for the first administrator.
  //   npx wrangler secret put SETUP_TOKEN
  // Temporary secret: IMPORT_TOKEN opens the catalogue import door (POST /api/admin/catalog-import, header
  // x-import-token). Created for the import, deleted right after: without it the door answers 503.
  //   npx wrangler secret put IMPORT_TOKEN
  //   npx wrangler secret delete IMPORT_TOKEN
  // Secrets of the push notifications on the staff's devices (worker/push.js), made by `node scripts/vapid-keys.mjs
  // mailto:<address>`: without them notifications are off (GET /api/push/key answers null) and the rest works.
  //   npx wrangler secret put VAPID_PUBLIC_KEY    (the public key, base64url)
  //   npx wrangler secret put VAPID_PRIVATE_KEY   (the private key, base64url: never in this repository)
  //   npx wrangler secret put VAPID_SUBJECT       (mailto:… or https://…, the contact given to the push services)
  // Local development reads .dev.vars (DEMO_ACCOUNTS=1 creates the demonstration accounts).
}
