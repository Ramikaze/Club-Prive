// Cloudflare configuration: one Worker serves the interface (dist/, built by Vite) and the API;
// the club's data lives in a Durable Object with its own SQLite database (free plan compatible).
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "club-prive",
  "main": "worker/index.js",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "durable_objects": {
    "bindings": [{ "name": "CLUB", "class_name": "ClubDO" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["ClubDO"] }],
  "observability": { "enabled": true },
  // Test version, separate from the clients' site: its own Worker (club-prive-test) and its own data.
  //   npm run deploy:test
  //   npx wrangler secret put SETUP_TOKEN --env test
  // Bindings and variables are not inherited by an environment: they are repeated here.
  "env": {
    "test": {
      "durable_objects": {
        "bindings": [{ "name": "CLUB", "class_name": "ClubDO" }]
      },
      "vars": { "INSTANCE_LABEL": "Version de test" }
    }
  }
  // Secret (not in this file): SETUP_TOKEN, the installation code for the first administrator.
  //   npx wrangler secret put SETUP_TOKEN
  // Local development reads .dev.vars (DEMO_ACCOUNTS=1 creates the demonstration accounts).
}
