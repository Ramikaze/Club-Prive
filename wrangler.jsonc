// Cloudflare configuration: one Worker serves the interface (dist/, built by Vite) and the API;
// the club's data lives in a Durable Object with its own SQLite database (free plan compatible).
// A second Durable Object, the demo space, holds the fictitious data of the training mode.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "club-prive",
  "main": "worker/index.js",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/login-smoke.mp4"]
  },
  "durable_objects": {
    "bindings": [
      { "name": "CLUB", "class_name": "ClubDO" },
      { "name": "DEMO", "class_name": "DemoDO" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["ClubDO"] },
    { "tag": "v2", "new_sqlite_classes": ["DemoDO"] }
  ],
  "observability": { "enabled": true }
  // Secret (not in this file): SETUP_TOKEN, the installation code for the first administrator.
  //   npx wrangler secret put SETUP_TOKEN
  // Local development reads .dev.vars (DEMO_ACCOUNTS=1 creates the demonstration accounts).
}
